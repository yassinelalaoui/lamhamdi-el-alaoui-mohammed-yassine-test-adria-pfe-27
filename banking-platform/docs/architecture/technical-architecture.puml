@startuml
title B2 - Architecture technique cible de la plateforme bancaire
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #126B68
  ArrowColor #526577
}
skinparam package {
  BackgroundColor #F4F7F8
  BorderColor #47616F
}
skinparam database {
  BackgroundColor #FFF8E6
  BorderColor #B58A34
}
skinparam note {
  BackgroundColor #FFF8E6
  BorderColor #B58A34
}

actor "Utilisateur" as User

package "Client web" <<boundary>> {
  component "Angular\nInterface utilisateur" as Angular
}

package "Identite et securite" <<boundary>> {
  component "Keycloak\nOAuth2 / OIDC" as Keycloak
}

package "Point d'entree" <<boundary>> {
  component "Spring Cloud Gateway\nRoutage et validation JWT" as Gateway
}

package "Services Spring" as SpringServices <<boundary>> {
  component "Account-Service\nComptes et soldes" as AccountService
  component "Transaction-Service\nTransactions et virements" as TransactionService
  component "Spring AI Assistant\nOrchestration conversationnelle" as AIAssistant
  component "MCP Client\nAppels d'outils autorises" as MCPClient
  component "Transaction Consumer\nTraitement des evenements" as TransactionConsumer
}

package "Outils metier MCP" <<boundary>> {
  component "MCP Servers (1..n)\nOutils metier" as MCPServers
}

package "Bus de messages" <<boundary>> {
  queue "Kafka\nTopics a definir" as Kafka
}

package "Plan de controle Spring Cloud" <<boundary>> {
  component "Config Server\nConfiguration centralisee" as ConfigServer
  component "Eureka\nRegistre et decouverte" as Eureka
}

package "Services externes" <<boundary>> {
  component "Fournisseur LLM\nA choisir" as LLM
}

package "Donnees - proprietes isolees" <<boundary>> {
  database "Account DB\nTechnologie a definir" as AccountDB
  database "Transaction DB\nTechnologie a definir" as TransactionDB
}

package "Experimentation hors production" <<boundary>> {
  component "Python\nLaboratoire detection de fraude" as PythonFraud
}

User --> Angular
Angular --> Gateway : 1
Angular <--> Keycloak : 5

Gateway --> AccountService : 1, 4
Gateway --> TransactionService : 1, 4
Gateway --> AIAssistant : 1

TransactionService --> AccountService : 2
TransactionService --> Kafka : 3
Kafka --> TransactionConsumer : 3

AIAssistant <--> LLM : 4
AIAssistant --> MCPClient : 4
MCPClient --> MCPServers : 4
MCPServers --> Gateway : 4

SpringServices ..> ConfigServer : 6
SpringServices ..> Eureka : 6

AccountService --> AccountDB
TransactionService --> TransactionDB

note bottom of TransactionDB
  Chaque base est accessible uniquement
  par son service proprietaire.
  Aucune liaison directe entre bases.
end note

note right of PythonFraud
  Experimentation uniquement dans cette cible.
  Aucune integration de production ni protocole
  de donnees n'est specifie pour B2.
end note

legend bottom
  Les numeros 1 a 6 correspondent aux flux et protocoles documentes dans technical-flows.md.
  Fleche pleine : appel synchrone, evenement Kafka ou stockage du service proprietaire.
  Fleche en pointilles : configuration ou decouverte du plan de controle.
  Les technologies de base et certains transports restent a confirmer.
endlegend
@enduml